# Copia este archivo como .env (no se sube a git) y completa los valores.

# Cadena de conexión de MongoDB Atlas: Database → Connect → Drivers → Node.js
MONGODB_URI="mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"

# Nombre de la base de datos (opcional; por defecto "dreamzone")
MONGODB_DB=dreamzone

# Puerto del servidor local (opcional; por defecto 3000)
PORT=3000

# --- Correo: código de recuperación, invitaciones, pago confirmado, pedido enviado y aviso de drops ---
# Sin SMTP no sale ningún correo: en local el código de recuperación se imprime en la consola de `npm run dev`
# y el enlace de invitación se copia desde el módulo Equipo de /admin.html.
# Gmail: activa la verificación en 2 pasos y crea una "contraseña de aplicación" (16 letras).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Remitente visible (opcional; por defecto "Dream Zone <SMTP_USER>")
MAIL_FROM="Dream Zone <tu-correo@gmail.com>"

# URL pública para los enlaces de los correos (en Vercel se toma sola del dominio de producción)
# APP_URL=https://tu-dominio.com

# --- Pagos con Wompi (panel de Wompi › Desarrolladores) ---
# Las llaves de prueba (pub_test_…) usan el sandbox; las de producción (pub_prod_…) cobran de verdad.
# En el panel, pon como URL de eventos: https://TU-DOMINIO/api/checkout/wompi
WOMPI_PUBLIC_KEY=pub_test_...
WOMPI_PRIVATE_KEY=prv_test_...
WOMPI_INTEGRITY_SECRET=test_integrity_...
WOMPI_EVENTS_SECRET=test_events_...

# --- Envíos: cotización en vivo con Envia.com (token de producción; solo cotiza, no genera guías) ---
# Sin él, el pago cobra las tarifas fijas de Curaduría › Página › Pago y envíos.
ENVIA_API_KEY=